      "id": "4e0285c0-5e7b-5a35-b119-0e923c1f9a1a",
      "name": "Charger BC, réceptions, IBAN connus",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        2660,
        100
