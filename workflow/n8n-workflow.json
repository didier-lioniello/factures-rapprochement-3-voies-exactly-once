    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Mode : Run Once for Each Item\n// La compta a été interrogée par référence externe = empreinte. Verdict sans ambiguïté :\n// trouvée => on confirme (surtout ne pas renvoyer) ; absente => renvoi sûr.\nconst hits = ($json.entries || $json.data || []).filter(e => e.external_reference === $('Candidats à réconcilier').item.json.fingerprint);\nif (hits.length > 1) throw new Error('Plusieurs écritures pour une même empreinte : alerte humaine');\nreturn { json: { invoice_id: $('Candidats à réconcilier').item.json.invoice_id,\n                 found: hits.length === 1, external_ref: hits[0]?.id ?? null } };\n"
      },
      "id": "3c6bf0c5-70f6-5fb4-ba00-f07c7dde9b09",
      "name": "Verdict : trouvée / absente",
